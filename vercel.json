{
  "buildCommand": "pip install -r requirements.txt",
  "framework": "streamlit",
  "env": [
    {
      "key": "STREAMLIT_SERVER_PORT",
      "value": "8501"
    },
    {
      "key": "STREAMLIT_SERVER_HEADLESS",
      "value": "true"
    },
    {
      "key": "STREAMLIT_SERVER_ENABLE_CORS",
      "value": "false"
    }
  ]
}
